# The SAME Lightspeed eCom (Ecwid) store ID and PUBLIC (read-only) token as the main store. Never put the secret token here.
NEXT_PUBLIC_ECWID_STORE_ID=
ECWID_PUBLIC_TOKEN=
# This site's own address, e.g. https://acesfragrance.ca
NEXT_PUBLIC_SITE_URL=
# Optional. The Lightspeed category this site sells from: its exact name or its numeric ID.
# When left empty the category in site.config.js is used (the "Ace's Fragrance" category).
ECWID_FRAGRANCE_CATEGORY=
